# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/nexora

# Security
JWT_SECRET=replace-with-a-strong-random-secret
